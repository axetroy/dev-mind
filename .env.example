# === GitLab Configuration ===
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_gitlab_personal_access_token

# === LLM Provider Configuration ===
# 支持任何兼容 OpenAI Chat API 的服务（OpenAI / Azure / OpenRouter / Groq / LocalAI / Ollama 等）
# Choose ONE provider:

# OpenAI (默认) — 也可以指向任何兼容 OpenAI 的 API
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1    # 默认值，可省略
# OPENAI_BASE_URL=https://openrouter.ai/api/v1  # 例：OpenRouter
# OPENAI_BASE_URL=http://localhost:11434/v1      # 例：Ollama (本地)
# LLM_MAX_TOKENS=16384  # 最大 token 数。推理模型（如 DeepSeek R1）需要更大值
# LLM_LANGUAGE=中文      # 模型输出语言偏好。留空 / auto 表示由模型自行决定

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# === Proxy Configuration (可选) ===
# 如果 LLM API 或 GitLab API 需要通过代理访问，取消注释并配置：
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# === Server Configuration ===
PORT=3000
NODE_ENV=development

# === Agent Configuration ===
# Max tool execution iterations per review
MAX_TOOL_ITERATIONS=10
# Risk thresholds
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_HIGH=70
